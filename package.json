{
  "name": "reviewfold",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.16.0"
  },
  "packageManager": "pnpm@11.20.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "boundaries": "depcruise src --config .dependency-cruiser.mjs",
    "boundaries:graph": "depcruise src --config .dependency-cruiser.mjs --include-only '^src/' --exclude '^src/routeTree[.]gen[.]ts$' --collapse '^src/(?:routes|functions|contracts)(?:/|$)|^src/ui/(?:design-system|shell|modules)(?:/|$)|^src/server/(?:modules|platform)(?:/|$)|^src/shared/(?:universal|ui|server)(?:/|$)' --output-type mermaid --output-to architecture-boundaries.mmd",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "docker compose down --remove-orphans",
    "db:reset": "bash scripts/db-reset.sh",
    "db:status": "docker compose ps",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "APP_ENV=test MONGODB_URI='mongodb://127.0.0.1:27017/?replicaSet=rs0' MONGODB_DATABASE=reviewfold_test RUN_MONGODB_INTEGRATION=1 vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm boundaries && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.3.0",
    "@astryxdesign/theme-neutral": "^0.3.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-form": "1.33.4",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.25",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.42",
    "mongodb": "^7.5.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.3.0",
    "@astryxdesign/cli": "^0.3.0",
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-cli": "1.167.27",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
